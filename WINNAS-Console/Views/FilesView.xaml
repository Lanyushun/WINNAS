<UserControl x:Class="Winnas.Console.Views.FilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PageBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,22">

            <Border Style="{StaticResource HintBar}" Margin="0,0,0,12"
                    Visibility="{Binding HelpVisible, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding HelpText, Mode=OneWay}" Style="{StaticResource HintBarText}"/>
            </Border>

            <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="0,0,0,12"
                    Visibility="{Binding Error, Converter={StaticResource StrVis}}">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerDarkBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="0,0,0,12"
                    Visibility="{Binding Notice, Converter={StaticResource StrVis}}">
                <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- ================================================== address bar -->
            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="⌂ 共享根" Style="{StaticResource DefaultButton}"
                                Command="{Binding GoHomeCommand}" Margin="0,0,8,0" Padding="10,6"/>
                        <Button Content="↑ 上级" Style="{StaticResource DefaultButton}"
                                Command="{Binding GoUpCommand}" Margin="0,0,8,0" Padding="10,6"/>
                        <Button Content="⟳ 刷新" Style="{StaticResource DefaultButton}"
                                Command="{Binding ReloadCommand}" Padding="10,6"/>
                    </StackPanel>

                    <Grid Grid.Column="1" Margin="14,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0"
                                 Text="{Binding AddressInput, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="目标机本地路径，例如 D:\NAS\Public。回车进入。">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding GoToAddressCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>
                        <Button Grid.Column="1" Content="前往" Style="{StaticResource DefaultButton}"
                                Command="{Binding GoToAddressCommand}" Margin="8,0,0,0" Padding="10,6"/>
                    </Grid>

                    <TextBlock Grid.Column="2" FontSize="11.5" VerticalAlignment="Center" Margin="14,0,0,0"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="位置："/>
                        <Run Text="{Binding LocationText, Mode=OneWay}" FontWeight="SemiBold"
                             Foreground="{DynamicResource TextMainBrush}"/>
                    </TextBlock>
                </Grid>
            </Border>

            <!-- ==================================================== actions -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBox Width="190" Margin="0,0,8,0"
                                 Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="新文件夹名称"/>
                        <Button Content="＋ 新建文件夹" Style="{StaticResource DefaultButton}"
                                Command="{Binding CreateFolderCommand}" Margin="0,0,16,0"/>

                        <Button Content="↑ 上传到此目录" Style="{StaticResource PrimaryButton}"
                                Command="{Binding UploadCommand}" Margin="0,0,8,0"/>
                        <Button Content="↓ 下载所选" Style="{StaticResource DefaultButton}"
                                Command="{Binding DownloadCommand}"
                                CommandParameter="{Binding Selected}"
                                IsEnabled="{Binding CanDownload}" Margin="0,0,8,0"/>
                        <Button Content="✎ 重命名" Style="{StaticResource DefaultButton}"
                                Command="{Binding BeginRenameCommand}"
                                CommandParameter="{Binding Selected}"
                                IsEnabled="{Binding HasSelection}" Margin="0,0,8,0"/>
                        <Button Content="🗑 删除" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteCommand}"
                                CommandParameter="{Binding Selected}"
                                IsEnabled="{Binding HasSelection}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="下载到" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"/>
                        <TextBlock Text="{Binding DownloadDir, Mode=OneWay}" FontSize="12" VerticalAlignment="Center"
                                   MaxWidth="220" TextTrimming="CharacterEllipsis" ToolTip="{Binding DownloadDir}"/>
                        <Button Content="更改" Style="{StaticResource LinkButton}"
                                Command="{Binding ChooseDownloadDirCommand}" Margin="8,0,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- =============================================== rename strip -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12"
                    Visibility="{Binding IsRenaming, Converter={StaticResource BoolVis}}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="重命名为" FontSize="12.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0"/>
                    <TextBox Width="280" Text="{Binding RenameText, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding CommitRenameCommand}"/>
                            <KeyBinding Key="Escape" Command="{Binding CancelRenameCommand}"/>
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="确定" Style="{StaticResource PrimaryButton}"
                            Command="{Binding CommitRenameCommand}" Margin="10,0,6,0" Padding="12,6"/>
                    <Button Content="取消" Style="{StaticResource DefaultButton}"
                            Command="{Binding CancelRenameCommand}" Padding="12,6"/>
                </StackPanel>
            </Border>

            <!-- ============================================== transfer state -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,12"
                    Visibility="{Binding Transferring, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding TransferText, Mode=OneWay}" FontSize="12"
                                   Foreground="{DynamicResource TextMainBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="取消" Style="{StaticResource LinkButton}"
                                Command="{Binding CancelTransferCommand}"/>
                    </Grid>
                    <ProgressBar Grid.Row="1" Height="8" Margin="0,8,0,0" Minimum="0" Maximum="1"
                                 Value="{Binding TransferRatio, Mode=OneWay}"
                                 Foreground="{DynamicResource PrimaryBrush}" Background="{DynamicResource BorderBrush}"
                                 BorderThickness="0"/>
                </Grid>
            </Border>

            <!-- ==================================================== shares -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0"
                    Visibility="{Binding AtRoot, Converter={StaticResource BoolVis}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="{Binding EntryTitle, Mode=OneWay}" Style="{StaticResource CardTitle}"/>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Shares}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              MaxHeight="420" BorderThickness="0">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenCommand}"
                                          CommandParameter="{Binding SelectedItem,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="240"/>
                            <DataGridTextColumn Header="位置" Binding="{Binding FullPath}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

            <TextBlock Margin="2,6,0,0" Style="{StaticResource CardHint}"
                       Visibility="{Binding AtRoot, Converter={StaticResource BoolVis}}"
                       Text="{Binding EntryHint, Mode=OneWay}"/>

            <!-- ================================================= directory -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0"
                    Visibility="{Binding AtRoot, Converter={StaticResource BoolVis}, ConverterParameter=inverse}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="{Binding LocationText, Mode=OneWay}"
                                       Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"
                                        VerticalAlignment="Center">
                                <TextBlock Text="筛选" FontSize="11.5" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,8,0"/>
                                <TextBox Style="{StaticResource SearchBox}" Width="200"
                                         Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="在当前目录内按名称过滤"/>
                                <Button Content="✕" Style="{StaticResource LinkButton}" FontSize="13"
                                        Command="{Binding ClearFilterCommand}" Margin="4,0,0,0"
                                        Visibility="{Binding HasFilter, Converter={StaticResource BoolVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding VisibleItems}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              MaxHeight="460" BorderThickness="0">
                        <DataGrid.InputBindings>
                            <MouseBinding MouseAction="LeftDoubleClick" Command="{Binding OpenCommand}"
                                          CommandParameter="{Binding SelectedItem,
                                            RelativeSource={RelativeSource AncestorType=DataGrid}}"/>
                        </DataGrid.InputBindings>
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="" Binding="{Binding Glyph}" Width="34"/>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="*"/>
                            <DataGridTextColumn Header="类型" Binding="{Binding KindText}" Width="110"/>
                            <DataGridTextColumn Header="大小" Width="100"
                                                Binding="{Binding Size, Converter={StaticResource Bytes}}"/>
                            <DataGridTextColumn Header="修改时间" Width="150"
                                                Binding="{Binding LastWrite, Converter={StaticResource Date}}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Grid.Row="2" Padding="16,10" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Text="没有匹配的文件。清掉筛选词再看一次。"
                               Visibility="{Binding HasFilter, Converter={StaticResource BoolVis}}"/>

                    <TextBlock Grid.Row="2" Padding="16,10" FontSize="12"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Setter Property="Text" Value="此目录为空，或当前凭据无权读取它。"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl> 