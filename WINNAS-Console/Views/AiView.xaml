<UserControl x:Class="Winnas.Console.Views.AiView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PageBgBrush}">
    <Grid Margin="22,18,22,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HintBar}" Margin="0,0,0,12"
                Visibility="{Binding HelpVisible, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding HelpText, Mode=OneWay}" Style="{StaticResource HintBarText}"/>
        </Border>

        <!-- key missing: the only thing worth interrupting the chat for -->
        <Border Grid.Row="1" Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                CornerRadius="8" Padding="14,11" Margin="0,0,0,12"
                Visibility="{Binding KeyConfigured, Converter={StaticResource BoolVis},
                             ConverterParameter=inverse}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap"
                           VerticalAlignment="Center"
                           Text="还没有配置 API Key，现在只能看不能说。模型接入在设置里，填一次就够。"/>
                <Button Grid.Column="1" Content="去配置" Style="{StaticResource DefaultButton}"
                        Command="{Binding OpenSettingsCommand}" Margin="14,0,0,0" Padding="12,6"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8"
                Padding="12,10" Margin="0,0,0,10"
                Visibility="{Binding Error, Converter={StaticResource StrVis}}">
            <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerDarkBrush}" FontSize="12" TextWrapping="Wrap"/>
        </Border>

        <!-- =========================================================== chat -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,11" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="对话" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource InfoSoftBrush}" Margin="10,0,0,0">
                                <TextBlock Text="{Binding ModelText, Mode=OneWay}" FontSize="10.5"
                                           Foreground="{DynamicResource PrimaryDarkBrush}"/>
                            </Border>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource HeaderBgBrush}" Margin="6,0,0,0">
                                <TextBlock Text="{Binding ContextText, Mode=OneWay}" FontSize="10.5"
                                           Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                            <TextBlock Text="{Binding TargetText, Mode=OneWay}" FontSize="11"
                                       VerticalAlignment="Center" Margin="10,0,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ContextNote, Mode=OneWay}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                       Margin="0,0,12,0"/>
                            <Button Content="AI 设置" Style="{StaticResource LinkButton}"
                                    Command="{Binding OpenSettingsCommand}" Margin="0,0,12,0"/>
                            <Button Content="清空" Style="{StaticResource LinkButton}"
                                    Command="{Binding ClearCommand}"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                              Padding="20,16">
                    <StackPanel>
                        <ItemsControl ItemsSource="{Binding Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12" Padding="14,11" Margin="0,0,0,14" MaxWidth="880">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="HorizontalAlignment" Value="Left"/>
                                                <Setter Property="Background" Value="{DynamicResource RowAltBrush}"/>
                                                <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                        <Setter Property="HorizontalAlignment" Value="Right"/>
                                                        <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource InfoBorderBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>

                                        <StackPanel>
                                            <TextBlock Text="{Binding Content, Mode=OneWay}" FontSize="13.5"
                                                       TextWrapping="Wrap" LineHeight="22"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                <TextBlock FontSize="10.5"
                                                           Foreground="{DynamicResource TextMutedBrush}">
                                                    <Run Text="{Binding TimeText, Mode=OneWay}"/>
                                                    <Run Text="  "/>
                                                    <Run Foreground="{DynamicResource PrimaryBrush}">
                                                        <Run.Style>
                                                            <Style TargetType="Run">
                                                                <Setter Property="Text" Value=""/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Streaming}" Value="True">
                                                                        <Setter Property="Text" Value="生成中…"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Run.Style>
                                                    </Run>
                                                </TextBlock>

                                                <Button Content="复制" FontSize="10.5" Margin="12,0,0,0" Padding="0"
                                                        Command="{Binding DataContext.CopyMessageCommand,
                                                                  RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource LinkButton}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsUser}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- empty state -->
                        <StackPanel Margin="0,10,0,0">
                            <StackPanel.Style>
                                <Style TargetType="StackPanel">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMessages}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </StackPanel.Style>

                            <TextBlock Text="✦" FontSize="30" HorizontalAlignment="Center"
                                       Foreground="{DynamicResource PrimaryBrush}" Margin="0,24,0,0"/>
                            <TextBlock Text="问点什么？" FontSize="16" FontWeight="SemiBold"
                                       HorizontalAlignment="Center" Margin="0,10,0,0"
                                       Foreground="{DynamicResource TextMainBrush}"/>
                            <TextBlock Text="它知道这台 NAS 现在长什么样——磁盘健康、卷容量、共享权限、快照与备份状态，都在上下文里。"
                                       Style="{StaticResource CardHint}" HorizontalAlignment="Center"
                                       Margin="0,6,0,0" TextWrapping="Wrap" MaxWidth="560"
                                       TextAlignment="Center"/>

                            <ItemsControl ItemsSource="{Binding QuickPrompts}" HorizontalAlignment="Center"
                                          Margin="0,18,0,0">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel MaxWidth="760"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}" Style="{StaticResource DefaultButton}"
                                                Command="{Binding DataContext.UsePromptCommand,
                                                          RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}"
                                                Margin="0,0,8,8" Padding="11,7" FontSize="12"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ========================================================== input -->
        <Border Grid.Row="4" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="14,12">
            <StackPanel>
                <TextBox Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" TextWrapping="Wrap" MinHeight="78" MaxHeight="180"
                         VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto"
                         ToolTip="Ctrl+Enter 发送，Enter 换行">
                    <TextBox.InputBindings>
                        <KeyBinding Key="Enter" Modifiers="Ctrl" Command="{Binding SendCommand}"/>
                    </TextBox.InputBindings>
                </TextBox>

                <Grid Margin="0,10,0,0">
                    <TextBlock FontSize="11.5" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextMutedBrush}">
                        <Run Text="Ctrl+Enter 发送"/>
                        <Run Text=" ｜ "/>
                        <Run Text="{Binding TargetText, Mode=OneWay}"/>
                        <Run Text=" ｜ "/>
                        <Run Text="{Binding ContextText, Mode=OneWay}"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="停止" Style="{StaticResource DefaultButton}"
                                Command="{Binding StopCommand}" Margin="0,0,8,0" MinWidth="84"
                                Visibility="{Binding Streaming, Converter={StaticResource BoolVis}}"/>
                        <Button Content="发送" Style="{StaticResource PrimaryButton}"
                                Command="{Binding SendCommand}" MinWidth="110"
                                IsEnabled="{Binding Streaming, Converter={StaticResource InvertBool}}"/>
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
