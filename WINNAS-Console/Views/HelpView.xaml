<UserControl x:Class="Winnas.Console.Views.HelpView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PageBgBrush}">
    <UserControl.Resources>
        <Style x:Key="LogRow" TargetType="DataGridRow">
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource InfoSoftBrush}"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="18,14,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource HintBar}" Margin="2,0,2,12"
                Visibility="{Binding HelpVisible, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding HelpText, Mode=OneWay}" Style="{StaticResource HintBarText}"/>
        </Border>

        <Border Grid.Row="1" Margin="2,0,2,10" Padding="12,8" CornerRadius="8"
                Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolVis}}">
            <TextBlock Text="{Binding Error, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource DangerTextBrush}" TextWrapping="Wrap"/>
        </Border>

        <TabControl Grid.Row="2">

            <!-- ==================================================== journal -->
            <TabItem Header="操作日志">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Style="{StaticResource Card}" Padding="14,11" Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="级别" Style="{StaticResource Label}" VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <ComboBox ItemsSource="{Binding LevelOptions}" SelectedItem="{Binding LevelText}"
                                          Width="96" Margin="0,0,14,0"/>

                                <TextBox Style="{StaticResource SearchBox}" Width="240"
                                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="按内容、分类或详情过滤"/>
                                <Button Content="✕" Style="{StaticResource LinkButton}" FontSize="13"
                                        Command="{Binding ClearSearchCommand}" Margin="4,0,0,0"
                                        Visibility="{Binding HasSearch, Converter={StaticResource BoolVis}}"/>

                                <TextBlock Text="{Binding SummaryText, Mode=OneWay}" Style="{StaticResource Label}"
                                           VerticalAlignment="Center" Margin="16,0,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <CheckBox Content="自动跟随最新" IsChecked="{Binding AutoFollow}"
                                          VerticalAlignment="Center" Margin="0,0,14,0" FontSize="12"/>
                                <Button Content="⟳ 重新载入" Style="{StaticResource DefaultButton}"
                                        Command="{Binding ReloadCommand}" Padding="10,6" Margin="0,0,8,0"/>
                                <Button Content="导出" Style="{StaticResource DefaultButton}"
                                        Command="{Binding ExportLogsCommand}" Padding="10,6" Margin="0,0,8,0"/>
                                <Button Content="打开目录" Style="{StaticResource DefaultButton}"
                                        Command="{Binding OpenLogDirCommand}" Padding="10,6" Margin="0,0,8,0"/>
                                <Button Content="清空" Style="{StaticResource DefaultButton}"
                                        Command="{Binding ClearLogsCommand}" Padding="10,6"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0">
                        <Grid>
                            <DataGrid ItemsSource="{Binding VisibleEntries}"
                                      SelectedItem="{Binding SelectedEntry}"
                                      RowStyle="{StaticResource LogRow}"
                                      MaxHeight="520" BorderThickness="0" SelectionMode="Single">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="时间" Width="118" Binding="{Binding TimeText}"/>
                                    <DataGridTemplateColumn Header="级别" Width="66">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource Pill}" Padding="7,2">
                                                    <Border.Background>
                                                        <SolidColorBrush Color="Transparent"/>
                                                    </Border.Background>
                                                    <TextBlock Text="{Binding LevelText}" FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="{Binding Level,
                                                                 Converter={StaticResource LogLevelBrush}}"/>
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="分类" Width="86" Binding="{Binding Category}"/>
                                    <DataGridTextColumn Header="内容" Width="*" Binding="{Binding Message}"/>
                                    <DataGridTextColumn Header="详情" Width="260" Binding="{Binding Detail}"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <Border Padding="20,26" Background="{DynamicResource CardBgBrush}"
                                    Visibility="{Binding VisibleEntries.Count, Converter={StaticResource CountVis},
                                                 ConverterParameter=inverse}">
                                <StackPanel HorizontalAlignment="Center">
                                    <TextBlock Text="暂无日志记录" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextMainBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="连接成功后，所有操作与失败都会记到这里。"
                                               Style="{StaticResource CardHint}" Margin="0,6,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14,11" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="日志保留" Style="{StaticResource Label}"
                                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox Width="52" Text="{Binding KeepDays, UpdateSourceTrigger=PropertyChanged}"/>
                                <TextBlock Text="天" Style="{StaticResource Label}"
                                           VerticalAlignment="Center" Margin="6,0,0,0"/>
                                <Button Content="清理旧日志" Style="{StaticResource DefaultButton}"
                                        Command="{Binding PruneOldCommand}" Padding="10,6" Margin="12,0,0,0"/>
                            </StackPanel>

                            <Button Grid.Column="1" Content="复制路径" Style="{StaticResource DefaultButton}"
                                    Command="{Binding CopyPathsCommand}" Padding="10,6" Margin="16,0,0,0"/>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right"
                                       Style="{StaticResource CardHint}" FontSize="11">
                                <Run Text="配置 " Foreground="{DynamicResource TextMutedBrush}"/>
                                <Run Text="{Binding ConfigPath, Mode=OneWay}"/>
                                <Run Text="   ·   日志 "/>
                                <Run Text="{Binding LogDir, Mode=OneWay}"/>
                            </TextBlock>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ====================================================== help -->
            <TabItem Header="帮助中心">
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="200"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource Card}" Padding="8"
                            VerticalAlignment="Stretch" Margin="0,0,12,0">
                        <ListBox ItemsSource="{Binding Groups}" SelectedItem="{Binding SelectedGroup}"
                                 BorderThickness="0" Background="Transparent">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,9"/>
                                    <Setter Property="Margin" Value="0,1"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="row" Background="Transparent"
                                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Glyph}" FontSize="13"
                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                   Margin="0,0,8,0" VerticalAlignment="Center"/>
                                                        <TextBlock x:Name="cap" Text="{Binding Title}" FontSize="13"
                                                                   Foreground="{DynamicResource TextMainBrush}"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource SelectedBgBrush}"/>
                                                        <Setter TargetName="cap" Property="Foreground"
                                                                Value="{DynamicResource PrimaryDarkBrush}"/>
                                                        <Setter TargetName="cap" Property="FontWeight" Value="SemiBold"/>
                                                    </Trigger>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="row" Property="Background" Value="{DynamicResource SubtleBgBrush}"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>

                    <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <ItemsControl ItemsSource="{Binding SelectedGroup.Topics}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,0,0,10">
                                            <StackPanel>
                                                <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}"/>
                                                <TextBlock Text="{Binding Body}" FontSize="12.5"
                                                           Foreground="{DynamicResource TextMainBrush}"
                                                           TextWrapping="Wrap" LineHeight="20"
                                                           Margin="0,7,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Style="{StaticResource Card}" Padding="16,13" Margin="0,4,0,0">
                                <StackPanel>
                                    <TextBlock Text="关于" Style="{StaticResource SectionTitle}"/>
                                    <Grid Margin="0,9,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="版本"
                                                   Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="0" Grid.Column="1" FontSize="12.5"
                                                   Text="{Binding VersionText, Mode=OneWay}"/>

                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="运行时" Margin="0,6,0,0"
                                                   Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="1" Grid.Column="1" FontSize="12.5" Margin="0,6,0,0"
                                                   Text="{Binding RuntimeText, Mode=OneWay}"/>

                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="配置文件" Margin="0,6,0,0"
                                                   Style="{StaticResource Label}"/>
                                        <TextBlock Grid.Row="2" Grid.Column="1" FontSize="12.5" Margin="0,6,0,0"
                                                   Text="{Binding ConfigPath, Mode=OneWay}" TextWrapping="Wrap"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="打开配置目录" Style="{StaticResource DefaultButton}"
                                                Command="{Binding OpenConfigDirCommand}" Padding="10,6"
                                                Margin="0,0,8,0"/>
                                        <Button Content="打开日志目录" Style="{StaticResource DefaultButton}"
                                                Command="{Binding OpenLogDirCommand}" Padding="10,6"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl> 