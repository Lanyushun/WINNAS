<UserControl x:Class="Winnas.Console.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PageBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,22">

            <Border Style="{StaticResource HintBar}" Margin="0,0,0,12"
                    Visibility="{Binding HelpVisible, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding HelpText, Mode=OneWay}" Style="{StaticResource HintBarText}"/>
            </Border>


            <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="0,0,0,12"
                    Visibility="{Binding Error, Converter={StaticResource StrVis}}">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerDarkBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- ================================================== services -->
            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="关键服务" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="关注的服务列表可在项目配置中调整（watchedServices）。"
                               Style="{StaticResource CardHint}" Margin="0,3,0,0"/>

                    <ItemsControl ItemsSource="{Binding Info.Services}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Padding="12,9" Margin="0,0,10,10" Width="228">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Ellipse Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource TextMutedBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding State}" Value="Running">
                                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding State}" Value="Stopped">
                                                            <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                       Margin="0,2,0,0">
                                                <Run Text="{Binding DisplayName, Mode=OneWay}"/>
                                            </TextBlock>
                                            <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                                <Run Text="{Binding State, Mode=OneWay}"/>
                                                <Run Text=" · 启动类型 "/>
                                                <Run Text="{Binding StartMode, Mode=OneWay}"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- ================================================== network -->
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="IPv4 地址" Style="{StaticResource CardTitle}"/>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Info.Addresses}" MaxHeight="230"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="地址" Binding="{Binding Address}" Width="150"/>
                                <DataGridTextColumn Header="掩码位" Binding="{Binding Prefix}" Width="70"/>
                                <DataGridTextColumn Header="接口" Binding="{Binding Interface}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="默认路由" Style="{StaticResource CardTitle}"/>
                        </Border>
                        <DataGrid Grid.Row="1" ItemsSource="{Binding Info.Routes}" MaxHeight="230"
                                  BorderThickness="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="网关" Binding="{Binding Gateway}" Width="150"/>
                                <DataGridTextColumn Header="接口" Binding="{Binding Interface}" Width="*"/>
                                <DataGridTextColumn Header="跃点数" Binding="{Binding Metric}" Width="90"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>
            </Grid>

            <!-- ============================================== top processes -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="内存占用 TOP 10" Style="{StaticResource CardTitle}"/>
                    </Border>
                    <DataGrid Grid.Row="1" ItemsSource="{Binding Info.TopProcesses}" MaxHeight="320"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="进程名" Binding="{Binding Name}" Width="200"/>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="100"/>
                            <DataGridTextColumn Header="内存占用" Width="140"
                                                Binding="{Binding Memory, Converter={StaticResource Bytes}}"/>
                            <DataGridTextColumn Header="备注" Width="*">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl> 