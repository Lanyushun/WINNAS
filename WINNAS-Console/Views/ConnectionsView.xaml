<UserControl x:Class="Winnas.Console.Views.ConnectionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PageBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,22">

            <Border Style="{StaticResource HintBar}" Margin="0,0,0,12"
                    Visibility="{Binding HelpVisible, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding HelpText, Mode=OneWay}" Style="{StaticResource HintBarText}"/>
            </Border>


            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="272"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- ================================================ list -->
                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <TextBlock Text="已保存的连接" Style="{StaticResource CardTitle}"/>
                        </Border>

                        <ListBox Grid.Row="1" ItemsSource="{Binding Profiles}"
                                 SelectedItem="{Binding Selected, Mode=TwoWay}"
                                 BorderThickness="0" Background="{DynamicResource CardBgBrush}" Padding="6" MinHeight="220">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="6,4">
                                        <TextBlock Text="{Binding Name}" FontSize="12.5" FontWeight="SemiBold"/>
                                        <TextBlock FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                                   Margin="0,1,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding TransportText, Mode=OneWay}"/>
                                            <Run Text=" · "/>
                                            <Run Text="{Binding Target, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border Grid.Row="2" Padding="10" BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <Button Content="＋ 新建连接" Style="{StaticResource DefaultButton}"
                                    Command="{Binding NewProfileCommand}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- =============================================== editor -->
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}" Padding="18,14">
                        <StackPanel>
                            <TextBlock>
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource CardTitle}">
                                        <Setter Property="Text" Value="编辑连接"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Selected}" Value="{x:Null}">
                                                <Setter Property="Text" Value="新建连接"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="名称" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditName, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="方式" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox SelectedIndex="{Binding EditTransportIndex}">
                                        <ComboBoxItem Content="本机（直接管理这台电脑）"/>
                                        <ComboBoxItem Content="远程 WMI（用下面填的账户）"/>
                                    </ComboBox>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="主机名或 IP" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditComputer, UpdateSourceTrigger=PropertyChanged}">
                                        <TextBox.Style>
                                            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBase}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EditTransportIndex}" Value="0">
                                                        <Setter Property="IsEnabled" Value="False"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBox.Style>
                                    </TextBox>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="域（可留空）" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditDomain, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                    <TextBlock Text="用户名" Style="{StaticResource FieldLabel}"/>
                                    <TextBox Text="{Binding EditUser, UpdateSourceTrigger=PropertyChanged}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                                    <PasswordBox x:Name="PwdBox" PasswordChanged="OnPasswordChanged"/>
                                </StackPanel>
                            </Grid>

                            <CheckBox Content="记住密码（用 Windows DPAPI 按当前用户加密存储）"
                                      IsChecked="{Binding RememberPassword}" Margin="0,12,0,0"/>

                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                <Button Content="保存" Style="{StaticResource PrimaryButton}"
                                        Command="{Binding SaveCommand}" Margin="0,0,8,0" MinWidth="78"/>
                                <Button Content="连接到此主机" Style="{StaticResource DefaultButton}"
                                        Command="{Binding ConnectCommand}" Margin="0,0,8,0" MinWidth="112"/>
                                <Button Content="连接诊断" Style="{StaticResource DefaultButton}"
                                        Command="{Binding DiagnoseCommand}" Margin="0,0,8,0" MinWidth="82"
                                        ToolTip="逐项检查网络端口、凭据、权限，并给出具体修复命令"/>
                                <Button Content="断开" Style="{StaticResource DefaultButton}"
                                        Command="{Binding DisconnectCommand}" Margin="0,0,8,0" MinWidth="70"/>
                                <Button Content="删除" Style="{StaticResource DefaultButton}"
                                        Command="{Binding RemoveCommand}" MinWidth="70"/>
                            </StackPanel>

                            <Border Background="{DynamicResource HeaderBgBrush}" CornerRadius="6" Padding="10,8" Margin="0,12,0,0"
                                    Visibility="{Binding Hint, Converter={StaticResource StrVis}}">
                                <TextBlock Text="{Binding Hint}" FontSize="12"
                                           Foreground="{DynamicResource TextMainBrush}" TextWrapping="Wrap"/>
                            </Border>

                            <Border Background="{DynamicResource RowAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="14,12" Margin="0,12,0,0"
                                    Visibility="{Binding DiagVisible, Converter={StaticResource BoolVis}}">
                                <StackPanel>
                                    <Grid>
                                        <TextBlock Text="连接诊断" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="正在检查…" FontSize="11.5" HorizontalAlignment="Right"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   Visibility="{Binding DiagRunning, Converter={StaticResource BoolVis}}"/>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Diagnostics}" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="16"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Mark}" FontWeight="Bold" FontSize="12"
                                                               Foreground="{Binding Color}"/>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"
                                                                   Foreground="{DynamicResource TextMainBrush}"/>
                                                        <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="11.5"
                                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                                                        <Border Background="{DynamicResource InputBgBrush}" CornerRadius="4" Padding="8,6" Margin="0,4,0,0"
                                                                Visibility="{Binding Fix, Converter={StaticResource StrVis}}">
                                                            <!-- A read-only TextBox, not a TextBlock: the fix
                                                                 is a command the user has to paste on the NAS. -->
                                                            <TextBox Text="{Binding Fix, Mode=OneWay}" IsReadOnly="True"
                                                                     TextWrapping="Wrap" FontSize="11" FontFamily="Consolas"
                                                                     Foreground="{DynamicResource TextSecondaryBrush}" Background="Transparent"
                                                                     BorderThickness="0" Padding="0" IsTabStop="False"/>
                                                        </Border>
                                                    </StackPanel>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="AI 分析" Style="{StaticResource DefaultButton}"
                                                Command="{Binding AiDiagnoseCommand}" Margin="0,0,8,0"
                                                ToolTip="把这次诊断的每一项交给模型，让它说清卡在哪一层、下一步做什么"/>
                                        <Button Content="复制排查脚本" Style="{StaticResource DefaultButton}"
                                                Command="{Binding CopyTargetScriptCommand}" Margin="0,0,8,0"
                                                ToolTip="复制一段在 NAS 上运行的脚本，用于控制台看不到的信息"/>
                                        <Button Content="停止" Style="{StaticResource DefaultButton}"
                                                Command="{Binding StopAiCommand}"
                                                Visibility="{Binding AiRunning, Converter={StaticResource BoolVis}}"/>
                                    </StackPanel>

                                    <Border Background="{DynamicResource InputBgBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,10,0,0"
                                            Visibility="{Binding AiVisible, Converter={StaticResource BoolVis}}">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,4">
                                                <TextBlock Text="AI 分析" FontWeight="SemiBold" FontSize="12"
                                                           Foreground="{DynamicResource TextMainBrush}"/>
                                                <TextBlock Text="生成中…" FontSize="11" HorizontalAlignment="Right"
                                                           Foreground="{DynamicResource WarningBrush}"
                                                           Visibility="{Binding AiRunning, Converter={StaticResource BoolVis}}"/>
                                            </Grid>
                                            <TextBox Text="{Binding AiText, Mode=OneWay}" IsReadOnly="True"
                                                     TextWrapping="Wrap" BorderThickness="0" Padding="0"
                                                     Background="Transparent" FontSize="12"
                                                     Foreground="{DynamicResource TextMainBrush}" IsTabStop="False"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- ============================================ help -->
                    <Border Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="16,14" Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="远程连接前置条件" FontWeight="SemiBold" FontSize="13"
                                       Foreground="{DynamicResource InfoTextBrush}"/>

                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InfoTextBrush}" Margin="0,8,0,0">
                                <Run Text="远程 DCOM（推荐）："/>
                                <Run Text="可以在上面填 NAS 的管理员账户，程序会用它登录；留空则用当前 Windows 账户。"/>
                                <Run Text="工作组环境建议写成 主机名\账户，例如 SHAWNNAS\Administrator。"/>
                            </TextBlock>
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                                <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                           Text="Enable-NetFirewallRule -DisplayGroup &quot;Windows Management Instrumentation (DCOM-In)&quot;,&quot;Windows Management Instrumentation (WMI-In)&quot;"/>
                            </Border>

                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InfoTextBrush}" Margin="0,12,0,0">
                                若凭据正确却仍提示拒绝访问，几乎是这条：工作组机器默认把本地账户的远程连接降权。
                            </TextBlock>
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                                <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                           Text="New-ItemProperty -Path HKLM://SOFTWARE//Microsoft//Windows//CurrentVersion//Policies//System -Name LocalAccountTokenFilterPolicy -Value 1 -PropertyType DWord -Force"/>
                            </Border>

                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InfoTextBrush}" Margin="0,12,0,0">
                                <Run Text="远程 WinRM："/>
                                <Run Text="目标机需先执行 winrm quickconfig，并在本机把它加入 TrustedHosts。"/>
                            </TextBlock>
                            <Border Background="{DynamicResource InputBgBrush}" CornerRadius="6" Padding="10,8" Margin="0,6,0,0">
                                <TextBlock FontFamily="Consolas" FontSize="11" TextWrapping="Wrap"
                                           Text="winrm quickconfig -q"/>
                            </Border>

                            <TextBlock TextWrapping="Wrap" FontSize="11.5" Foreground="{DynamicResource InfoTextBrush}" Margin="0,12,0,0"
                                       Text="不确定卡在哪一步？点上面的「连接诊断」，它会逐项检查并给出要执行的命令。"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl> 