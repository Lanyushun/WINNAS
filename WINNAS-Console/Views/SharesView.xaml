<UserControl x:Class="Winnas.Console.Views.SharesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PageBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="22,18,22,22">

            <Border Style="{StaticResource HintBar}" Margin="0,0,0,12"
                    Visibility="{Binding HelpVisible, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding HelpText, Mode=OneWay}" Style="{StaticResource HintBarText}"/>
            </Border>

            <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="0,0,0,12"
                    Visibility="{Binding Error, Converter={StaticResource StrVis}}">
                <TextBlock Text="{Binding Error}" Foreground="{DynamicResource DangerDarkBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="0,0,0,12"
                    Visibility="{Binding Notice, Converter={StaticResource StrVis}}">
                <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- ================================================== toolbar -->
            <Border Style="{StaticResource Card}" Padding="16,12">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="＋ 新建共享" Style="{StaticResource PrimaryButton}"
                                Command="{Binding OpenFormCommand}" Margin="0,0,10,0"/>

                        <Button Content="删除所选" Style="{StaticResource DangerButton}"
                                Command="{Binding DeleteShareCommand}" Margin="0,0,16,0"/>

                        <CheckBox Content="显示系统与管理共享（C$、ADMIN$ 等）"
                                  IsChecked="{Binding ShowSpecial}" VerticalAlignment="Center" Margin="0,0,16,0"/>

                        <Button Content="导出 CSV" Style="{StaticResource DefaultButton}"
                                Command="{Binding ExportCommand}" Padding="10,6"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBox Style="{StaticResource SearchBox}" Width="190" Margin="0,0,10,0"
                                 Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="按共享名、路径或描述过滤"/>
                        <Button Content="✕" Style="{StaticResource LinkButton}" FontSize="13"
                                Command="{Binding ClearFilterCommand}" Margin="4,0,14,0"
                                Visibility="{Binding HasFilter, Converter={StaticResource BoolVis}}"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                            <Run Text="活动会话 "/>
                            <Run Text="{Binding Sessions.Count, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextMainBrush}"/>
                            <Run Text=" ｜ 已打开文件 "/>
                            <Run Text="{Binding OpenFiles, Mode=OneWay}" FontWeight="SemiBold"
                                 Foreground="{DynamicResource TextMainBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ================================================ create form -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="16,14"
                    Visibility="{Binding FormVisible, Converter={StaticResource BoolVis}}">
                <StackPanel>
                    <TextBlock Text="新建共享" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="共享名" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewName, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="共享路径" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewPath, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="0" Grid.Column="2">
                            <TextBlock Text="描述（可选）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewDescription, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,12,12,0">
                            <TextBlock Text="授权账户（留空为 Everyone）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding NewAccount, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>
                    </Grid>

                    <CheckBox Content="只读共享（不勾选则为完全控制）" Margin="0,14,0,0"
                              IsChecked="{Binding NewReadOnly}"/>

                    <TextBlock Text="路径请填写目标机本地路径（例如 D:\NAS\Public）。远程管理时路径会被直接下发到目标机执行，不需要写成 UNC。"
                               Style="{StaticResource CardHint}" Margin="0,10,0,0"/>

                    <Border Background="{DynamicResource DangerSoftBrush}" BorderBrush="{DynamicResource DangerBorderBrush}" BorderThickness="1" CornerRadius="6"
                            Padding="10,8" Margin="0,10,0,0"
                            Visibility="{Binding FormError, Converter={StaticResource StrVis}}">
                        <TextBlock Text="{Binding FormError}" Foreground="{DynamicResource DangerDarkBrush}" FontSize="12" TextWrapping="Wrap"/>
                    </Border>

                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="创建" Style="{StaticResource PrimaryButton}"
                                Command="{Binding CreateShareCommand}" Margin="0,0,8,0" MinWidth="84"/>
                        <Button Content="取消" Style="{StaticResource DefaultButton}"
                                Command="{Binding CancelFormCommand}" MinWidth="72"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ==================================================== shares -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid ItemsSource="{Binding VisibleShares}"
                              SelectedItem="{Binding Selected, Mode=TwoWay}"
                              MaxHeight="440" BorderThickness="0"
                              RowDetailsVisibilityMode="VisibleWhenSelected">
                        <DataGrid.RowDetailsTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource RowAltBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,1,0,1" Padding="14,10">
                                    <StackPanel>
                                        <TextBlock Text="共享权限" FontSize="11.5" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,0,6"/>
                                        <ItemsControl ItemsSource="{Binding Access}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontSize="12" Margin="0,2,0,0">
                                                        <Run Text="{Binding AccountName, Mode=OneWay}" FontWeight="SemiBold"/>
                                                        <Run Text=" — "/>
                                                        <Run Text="{Binding RightText, Mode=OneWay}"/>
                                                        <Run Text="（"/><Run Text="{Binding TypeText, Mode=OneWay}"/><Run Text="）"/>
                                                    </TextBlock>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="（无权限条目）" FontSize="12"
                                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Access.Count}" Value="0">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </DataGrid.RowDetailsTemplate>

                        <DataGrid.Columns>
                            <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="150"/>
                            <DataGridTextColumn Header="路径" Binding="{Binding Path}" Width="*"/>
                            <DataGridTextColumn Header="权限" Width="280"
                                                Binding="{Binding Access, Converter={StaticResource ShareAccess}}"/>
                            <DataGridTextColumn Header="当前连接" Binding="{Binding CurrentUsers}" Width="82"/>
                            <DataGridTemplateColumn Header="状态" Width="76">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StateText}" VerticalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1" Padding="18,16"
                            Visibility="{Binding VisibleShares.Count, Converter={StaticResource CountVis},
                                         ConverterParameter=inverse}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="没有可显示的共享" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMainBrush}" HorizontalAlignment="Center"/>
                            <TextBlock Style="{StaticResource CardHint}" Margin="0,6,0,0"
                                       HorizontalAlignment="Center" TextAlignment="Center">
                                <Run Text="若筛选词没匹配上，清掉它再试；"/>
                                <LineBreak/>
                                <Run Text="若这台机器确实一个共享都没有，勾选「显示系统与管理共享」可以看到 C$、ADMIN$。"/>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <TextBlock Text="点击任意行可展开该共享的权限明细" Style="{StaticResource CardHint}" Margin="2,6,0,0"/>

            <!-- ================================================== sessions -->
            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Padding="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="16,12" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1">
                        <TextBlock Text="连接的客户端" Style="{StaticResource CardTitle}"/>
                    </Border>

                    <DataGrid Grid.Row="1" ItemsSource="{Binding Sessions}" MaxHeight="200" BorderThickness="0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="客户端" Binding="{Binding Client}" Width="200"/>
                            <DataGridTextColumn Header="用户" Binding="{Binding User}" Width="220"/>
                            <DataGridTextColumn Header="打开文件数" Binding="{Binding Opens}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl> 