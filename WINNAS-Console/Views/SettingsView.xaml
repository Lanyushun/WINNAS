<UserControl x:Class="Winnas.Console.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource PageBgBrush}">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="22,18,22,22" MaxWidth="1080" HorizontalAlignment="Left">

            <Border Style="{StaticResource HintBar}" Margin="0,0,0,12"
                    Visibility="{Binding HelpVisible, Converter={StaticResource BoolVis}}">
                <TextBlock Text="{Binding HelpText, Mode=OneWay}" Style="{StaticResource HintBarText}"/>
            </Border>

            <Border Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBorderBrush}" BorderThickness="1" CornerRadius="8"
                    Padding="12,10" Margin="0,0,0,12"
                    Visibility="{Binding Notice, Converter={StaticResource StrVis}}">
                <TextBlock Text="{Binding Notice}" Foreground="{DynamicResource SuccessBrush}" FontSize="12" TextWrapping="Wrap"/>
            </Border>

            <!-- ===================================================== 外观 -->
            <Border Style="{StaticResource Card}" Padding="18,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="界面皮肤" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding SelectedSkin.Name, Mode=OneWay}" FontSize="11.5"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                    <TextBlock Text="点一下就换，整个界面立刻重绘，不用重启。选中的皮肤会存进配置文件，下次打开还是它。"
                               Style="{StaticResource CardHint}" Margin="0,3,0,0"/>

                    <ListBox ItemsSource="{Binding Skins}" SelectedItem="{Binding SelectedSkin, Mode=TwoWay}"
                             Background="Transparent" BorderThickness="0" Padding="0"
                             Margin="0,14,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Disabled">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="3"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>

                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,10,10"/>
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Cursor" Value="Hand"/>
                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Shell" CornerRadius="10" BorderThickness="1"
                                                    Padding="9"
                                                    Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}">
                                                <ContentPresenter/>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Shell" Property="BorderBrush"
                                                            Value="{DynamicResource BorderStrongBrush}"/>
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Shell" Property="BorderBrush"
                                                            Value="{DynamicResource PrimaryBrush}"/>
                                                    <Setter TargetName="Shell" Property="BorderThickness" Value="2"/>
                                                    <Setter TargetName="Shell" Property="Padding" Value="8"/>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>

                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <!-- 缩略图用自己的颜色画，所以预览永远等于实际效果 -->
                                    <Border Grid.Column="0" Width="92" Height="62" CornerRadius="6"
                                            Background="{Binding PageBrush}" ClipToBounds="True">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="26"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0" Background="{Binding CardBrush}"/>

                                            <Border Grid.Column="1" Background="{Binding CardBrush}"
                                                    CornerRadius="4" Margin="5,6">
                                                <StackPanel VerticalAlignment="Center" Margin="6,0,0,0">
                                                    <Border Height="6" Width="26" CornerRadius="3"
                                                            HorizontalAlignment="Left"
                                                            Background="{Binding AccentBrush}"/>
                                                    <Border Height="3" Width="44" CornerRadius="1.5"
                                                            HorizontalAlignment="Left" Margin="0,6,0,0"
                                                            Opacity="0.45"
                                                            Background="{Binding TextBrush}"/>
                                                    <Border Height="3" Width="30" CornerRadius="1.5"
                                                            HorizontalAlignment="Left" Margin="0,3,0,0"
                                                            Opacity="0.28"
                                                            Background="{Binding TextBrush}"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <Grid>
                                            <TextBlock Text="{Binding Name, Mode=OneWay}" FontSize="12.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextMainBrush}"/>
                                            <TextBlock Text="{Binding ModeText, Mode=OneWay}" FontSize="10.5"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                        <TextBlock Text="{Binding Hint, Mode=OneWay}" FontSize="10.5"
                                                   TextWrapping="Wrap" LineHeight="15" Margin="0,3,0,0"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <!-- ===================================================== 通用 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="通用" Style="{StaticResource CardTitle}"/>
                    <TextBlock Text="影响界面刷新与日志留存，改动立即生效并自动保存。"
                               Style="{StaticResource CardHint}" Margin="0,3,0,0"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="自动刷新间隔" Style="{StaticResource FieldLabel}"/>
                            <ComboBox ItemsSource="{Binding RefreshChoices}"
                                      SelectedItem="{Binding RefreshSeconds, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock>
                                            <Run Text="{Binding Mode=OneWay}"/><Run Text=" 秒"/>
                                        </TextBlock>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <TextBlock Text="只刷新当前打开的页面；远控、设置、连接页不参与自动刷新。"
                                       Style="{StaticResource CardHint}" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="操作日志保留天数" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding LogKeepDays, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="按天分文件存到 logs 目录，超期的会在写入时自动清理。"
                                       Style="{StaticResource CardHint}" Margin="0,4,0,0"/>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="关注的服务（逗号分隔的服务名）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding WatchedServicesText, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="系统页只显示这些服务。留空表示显示全部。"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" VerticalAlignment="Bottom">
                            <CheckBox Content="在每个页面顶部显示用途说明条"
                                      IsChecked="{Binding ShowPageHelp, Mode=TwoWay}"/>
                            <TextBlock Text="关掉之后，页面更紧凑；随时可以用标题栏的齿轮菜单再打开。"
                                       Style="{StaticResource CardHint}" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ================================================== AI 助手 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="AI 助手" Style="{StaticResource CardTitle}" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding KeyStateText, Mode=OneWay}" FontSize="11.5"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                    <TextBlock Text="兼容任何 OpenAI /chat/completions 接口（DeepSeek、Moonshot、智谱、通义、本地 Ollama 兼容层）。请求直连你填的地址，程序不做中转。"
                               Style="{StaticResource CardHint}" Margin="0,3,0,0"/>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="API Base" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding AiBaseUrl, UpdateSourceTrigger=LostFocus}"
                                     ToolTip="DeepSeek 填 https://api.deepseek.com ；OpenAI 填 https://api.openai.com/v1"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Margin="0,0,12,0">
                            <TextBlock Text="模型" Style="{StaticResource FieldLabel}"/>
                            <ComboBox IsEditable="True" IsTextSearchEnabled="True"
                                      ItemsSource="{Binding Models}"
                                      Text="{Binding AiModel, UpdateSourceTrigger=PropertyChanged}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="API Key" Style="{StaticResource FieldLabel}"/>

                            <!-- 保存后只看得到掩码，点「编辑」才展开明文，避免截图时把 Key 拍进去 -->
                            <Grid Visibility="{Binding KeyEditing, Converter={StaticResource BoolVis}}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding ApiKeyInput, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="保存前用 DPAPI 按当前用户加密；留空并保存表示清除"/>
                                <Button Grid.Column="1" Content="保存" Style="{StaticResource DefaultButton}"
                                        Command="{Binding SaveApiKeyCommand}" Margin="6,0,0,0" MinWidth="58"/>
                            </Grid>

                            <Grid Visibility="{Binding KeyEditing, Converter={StaticResource BoolVis},
                                                ConverterParameter=inverse}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" CornerRadius="6" Padding="8,6"
                                        Background="{DynamicResource InputBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <TextBlock Text="{Binding MaskedKey, Mode=OneWay}" FontSize="13"
                                               FontFamily="Consolas" TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </Border>
                                <Button Grid.Column="1" Content="编辑" Style="{StaticResource DefaultButton}"
                                        Command="{Binding EditKeyCommand}" Margin="6,0,0,0" MinWidth="58"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="240"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="温度" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMutedBrush}" Margin="0,0,10,0"/>
                        <Slider Grid.Column="1" Minimum="0" Maximum="1.2" TickFrequency="0.1"
                                IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                Value="{Binding AiTemperature, Mode=TwoWay}"/>
                        <TextBlock Grid.Column="2" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Text="{Binding AiTemperature, StringFormat={}{0:0.0}, Mode=OneWay}"/>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" HorizontalAlignment="Right">
                            <TextBlock Text="{Binding ModelNote, Mode=OneWay}" FontSize="11.5"
                                       VerticalAlignment="Center" Margin="0,0,10,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <Button Content="获取模型列表" Style="{StaticResource LinkButton}"
                                    Command="{Binding FetchModelsCommand}"/>
                            <Button Content="测试连接" Style="{StaticResource DefaultButton}" Padding="10,5"
                                    Command="{Binding TestConnectionCommand}" Margin="10,0,0,0"
                                    IsEnabled="{Binding Testing, Converter={StaticResource InvertBool}}"/>
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="{Binding AiStatus, Mode=OneWay}" FontSize="11.5" Margin="0,8,0,0"
                               Foreground="{DynamicResource TextMutedBrush}"
                               Visibility="{Binding AiStatus, Converter={StaticResource StrVis}}"/>

                    <TextBlock Text="系统提示词（决定它扮演什么角色）" Style="{StaticResource FieldLabel}"
                               Margin="0,14,0,0"/>
                    <TextBox Text="{Binding AiSystemPrompt, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" Height="74"
                             VerticalContentAlignment="Top"/>

                    <Grid Margin="0,10,0,0">
                        <CheckBox Content="提问时自动附带被控端的实时状态（磁盘、卷、共享、快照、备份）"
                                  IsChecked="{Binding AiAttachContext, Mode=TwoWay}" VerticalAlignment="Center"/>
                        <Button Content="恢复默认提示词" Style="{StaticResource LinkButton}"
                                HorizontalAlignment="Right" Command="{Binding ResetPromptCommand}"/>
                    </Grid>

                    <TextBlock Style="{StaticResource CardHint}" Margin="0,8,0,0"
                               Text="配上之后，AI 页就是纯对话界面，设置不再占地方。换机器或换 Windows 用户后 Key 需要重新填——DPAPI 只对写入它的那个用户有效。"/>
                </StackPanel>
            </Border>

            <!-- =================================================== 被控端 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="被控端与路径" Style="{StaticResource CardTitle}"/>

                    <Border Background="{DynamicResource InfoSoftBrush}" BorderBrush="{DynamicResource InfoBorderBrush}" BorderThickness="1" CornerRadius="8"
                            Padding="12,10" Margin="0,10,0,0">
                        <StackPanel>
                            <TextBlock Text="{Binding TargetText, Mode=OneWay}" FontSize="12.5"
                                       FontWeight="SemiBold" Foreground="{DynamicResource InfoTextBrush}"/>
                            <TextBlock Text="{Binding TargetExplain, Mode=OneWay}" FontSize="11.5"
                                       Foreground="{DynamicResource InfoTextBrush}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0">
                            <TextBlock Text="网络唤醒 MAC（存到当前连接）" Style="{StaticResource FieldLabel}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBox Grid.Column="0" Text="{Binding WakeMac, UpdateSourceTrigger=PropertyChanged}"
                                         FontFamily="Consolas" ToolTip="例如 00-11-22-33-44-55"/>
                                <Button Grid.Column="1" Content="保存" Style="{StaticResource DefaultButton}"
                                        Command="{Binding SaveWakeMacCommand}" Margin="6,0,0,0" MinWidth="58"/>
                            </Grid>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="备份日志目录（被控端上的路径）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Text="{Binding BackupPlanLogDir, UpdateSourceTrigger=LostFocus}"
                                     FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Margin="0,12,0,0">
                        <TextBlock Text="远控命令输出目录（只读）" Style="{StaticResource FieldLabel}"/>
                        <TextBox Text="{Binding RemoteDir, Mode=OneWay}" IsReadOnly="True"
                                 FontFamily="Consolas"/>
                        <TextBlock Style="{StaticResource CardHint}" Margin="0,4,0,0"
                                   Text="远程命令的输出写在被控端的这个目录里，控制台通过管理共享读回。太多了可以手工清理，不影响程序。"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ===================================================== 关于 -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18,16">
                <StackPanel>
                    <TextBlock Text="关于" Style="{StaticResource CardTitle}"/>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,28,0">
                            <TextBlock Text="版本" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding VersionText, Mode=OneWay}" FontSize="12.5"/>
                            <TextBlock Text="运行时" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding RuntimeText, Mode=OneWay}" FontSize="12.5"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="程序位置" Style="{StaticResource FieldLabel}"/>
                            <TextBlock Text="{Binding ExePath, Mode=OneWay}" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="配置文件" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding ConfigPath, Mode=OneWay}" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Text="操作日志目录" Style="{StaticResource FieldLabel}" Margin="0,10,0,0"/>
                            <TextBlock Text="{Binding LogDir, Mode=OneWay}" FontSize="11.5"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                    </Grid>

                    <!-- project, contact and version check -->
                    <StackPanel Margin="0,16,0,0">
                        <TextBlock Text="项目与更新" Style="{StaticResource CardTitle}" Margin="0,0,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="GitHub" Style="{StaticResource FieldLabel}"
                                       Width="86" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource LinkButton}" Command="{Binding OpenRepoCommand}"
                                    Padding="0,2" ToolTip="点击打开仓库主页">
                                <TextBlock Text="{Binding RepoUrl, Mode=OneWay}" FontSize="11.5"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="联系方式" Style="{StaticResource FieldLabel}"
                                       Width="86" VerticalAlignment="Center"/>
                            <Button Style="{StaticResource LinkButton}" Command="{Binding ContactAuthorCommand}"
                                    Padding="0,2" ToolTip="点击用默认邮件客户端发送邮件">
                                <TextBlock Text="{Binding ContactEmail, Mode=OneWay}" FontSize="11.5"/>
                            </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="更新仓库" Style="{StaticResource FieldLabel}"
                                       Width="86" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding UpdateRepo, UpdateSourceTrigger=LostFocus}" Width="230"
                                     ToolTip="填 owner/repo 或完整 GitHub 地址；格式不对会自动回退到默认仓库"/>
                            <TextBlock Text="owner/repo" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>

                        <CheckBox Content="启动时自动检查更新（只在发现新版本时提示）"
                                  IsChecked="{Binding CheckUpdateOnStartup}" Margin="86,2,0,10"/>

                        <StackPanel Orientation="Horizontal" Margin="86,0,0,0">
                            <Button Content="立即检查更新" Style="{StaticResource DefaultButton}"
                                    Command="{Binding CheckUpdateCommand}" Padding="12,6" Margin="0,0,10,0"/>
                            <TextBlock Text="{Binding UpdateStatusText, Mode=OneWay}" FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <Button Content="打开配置目录" Style="{StaticResource DefaultButton}"
                                Command="{Binding OpenConfigDirCommand}" Margin="0,0,8,0" Padding="12,6"/>
                        <Button Content="打开日志目录" Style="{StaticResource DefaultButton}"
                                Command="{Binding OpenLogDirCommand}" Padding="12,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>
