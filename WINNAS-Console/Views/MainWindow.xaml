<Window x:Class="Winnas.Console.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Winnas.Console.ViewModels"
        Title="WINNAS 控制台"
        Height="880" Width="1360" MinHeight="640" MinWidth="1040"
        FontFamily="Segoe UI, Microsoft YaHei"
        Background="{DynamicResource PageBgBrush}"
        Loaded="OnLoaded" Closing="OnClosing">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}"/>
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding OpenSettingsPageCommand}"/>
        <KeyBinding Key="D1" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="1"/>
        <KeyBinding Key="D2" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="2"/>
        <KeyBinding Key="D3" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="3"/>
        <KeyBinding Key="D4" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="4"/>
        <KeyBinding Key="D5" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="5"/>
        <KeyBinding Key="D6" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="6"/>
        <KeyBinding Key="D7" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="7"/>
        <KeyBinding Key="D8" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="8"/>
        <KeyBinding Key="D9" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="9"/>
        <KeyBinding Key="D0" Modifiers="Ctrl" Command="{Binding GoToPageCommand}" CommandParameter="0"/>
        <KeyBinding Key="D1" Modifiers="Ctrl+Shift" Command="{Binding GoToPageCommand}" CommandParameter="11"/>
        <KeyBinding Key="D2" Modifiers="Ctrl+Shift" Command="{Binding GoToPageCommand}" CommandParameter="12"/>
        <KeyBinding Key="D3" Modifiers="Ctrl+Shift" Command="{Binding GoToPageCommand}" CommandParameter="13"/>
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="218"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- sidebar  -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="18,20,16,10">
                    <TextBlock Text="WINNAS" FontSize="19" FontWeight="Bold"
                               Foreground="{DynamicResource TextMainBrush}"/>
                    <TextBlock Text="Windows NAS 控制台" FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0"/>
                    <TextBlock Text="跑在笔记本 · 管着那台 NAS" FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                </StackPanel>

                <ListBox Grid.Row="1"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding CurrentPage, Mode=TwoWay}"
                         Style="{StaticResource NavList}"
                         ItemContainerStyle="{StaticResource NavItem}"/>

                <Border Grid.Row="2" Margin="10,6,10,10" Padding="12,10"
                        Background="{DynamicResource HeaderBgBrush}" CornerRadius="8">
                    <StackPanel>
                        <TextBlock Text="当前被控端" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding CurrentProfile.Name, FallbackValue='—'}"
                                   FontSize="12.5" FontWeight="SemiBold" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMainBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentProfile.Target, FallbackValue='未连接'}"
                                   FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding CurrentProfile.TransportText, FallbackValue=''}"
                                   FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,1,0,0"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- main  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                    Padding="22,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding CurrentPage.Title}" FontSize="17" FontWeight="SemiBold"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMainBrush}"/>
                            <Border Style="{StaticResource Pill}" Background="{DynamicResource InfoSoftBrush}" Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding Connected, Converter={StaticResource BoolVis}}">
                                <TextBlock Text="{Binding ControlledLabel, Mode=OneWay}" FontSize="10.5"
                                           Foreground="{DynamicResource PrimaryDarkBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StatusText}" FontSize="11.5" Margin="0,3,0,0"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <!-- GitHub tip: hovering shows the repo URL and contact address -->
                        <Button Style="{StaticResource LinkButton}" Command="{Binding OpenGitHubCommand}"
                                ToolTip="{Binding GitHubTip, Mode=OneWay}" VerticalAlignment="Center"
                                Margin="0,0,12,0">
                            <TextBlock Text="{Binding GitHubLabel, Mode=OneWay}"
                                       FontSize="11.5" FontWeight="SemiBold"/>
                        </Button>

                        <Button Content="{Binding CheckUpdateButtonText, Mode=OneWay}"
                                Style="{StaticResource DefaultButton}" Command="{Binding CheckUpdateCommand}"
                                IsEnabled="{Binding IsCheckingUpdate, Converter={StaticResource InvertBool}}"
                                ToolTip="对比 GitHub 上最新的 Release 版本"
                                Margin="0,0,8,0" MinWidth="86"/>

                        <Border Background="{DynamicResource InfoSoftBrush}" CornerRadius="6" Padding="10,5" Margin="0,0,10,0"
                                Visibility="{Binding IsConnecting, Converter={StaticResource BoolVis}}">
                            <TextBlock Text="连接中..." FontSize="11.5" Foreground="{DynamicResource PrimaryDarkBrush}"/>
                        </Border>

                        <Border Style="{StaticResource Badge}" Background="{DynamicResource WarningSoftBrush}" Margin="0,0,10,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis},
                                             ConverterParameter=inverse}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="非管理员：写操作会失败"
                                       Foreground="{DynamicResource WarningTextBrush}"/>
                        </Border>

                        <CheckBox Content="自动刷新" IsChecked="{Binding AutoRefresh}"
                                  VerticalAlignment="Center" Margin="0,0,12,0"/>

                        <Button Content="刷新 (F5)" Style="{StaticResource DefaultButton}"
                                Command="{Binding RefreshCommand}" Margin="0,0,8,0" MinWidth="86"/>

                        <Button Content="断开" Style="{StaticResource DefaultButton}"
                                Command="{Binding DisconnectNowCommand}" Margin="0,0,8,0" MinWidth="68"/>

                        <!-- settings menu  -->
                        <Button x:Name="SettingsButton" Style="{StaticResource DefaultButton}"
                                Padding="10,6" MinWidth="0" Click="OnSettingsMenuClick"
                                ToolTip="设置菜单（Ctrl+, 直接打开设置页）">
                            <TextBlock Text="⚙" FontSize="14"/>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SettingsMenu">
                                    <MenuItem Header="设置…" InputGestureText="Ctrl+,"
                                              Command="{Binding OpenSettingsPageCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="自动刷新" IsCheckable="True"
                                              IsChecked="{Binding AutoRefresh, Mode=TwoWay}"/>
                                    <MenuItem Header="显示页面帮助条" IsCheckable="True"
                                              IsChecked="{Binding ShowPageHelpSetting, Mode=TwoWay}"/>
                                    <MenuItem Header="刷新当前页" InputGestureText="F5"
                                              Command="{Binding RefreshCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="打开配置目录" Command="{Binding OpenConfigDirCommand}"/>
                                    <MenuItem Header="打开日志目录" Command="{Binding OpenActivityLogDirCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="检查更新…" Command="{Binding CheckUpdateCommand}"/>
                                    <MenuItem Header="打开 GitHub 仓库" Command="{Binding OpenGitHubCommand}"/>
                                    <MenuItem Header="打开 Releases 页" Command="{Binding OpenReleasesCommand}"/>
                                    <MenuItem Header="联系作者（邮件）" Command="{Binding ContactAuthorCommand}"/>
                                    <Separator/>
                                    <MenuItem Header="关于 WINNAS 控制台" Command="{Binding ShowAboutCommand}"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- page body plus the toast overlay  -->
            <Grid Grid.Row="1">
                <ContentControl Content="{Binding CurrentPage}" Margin="0"/>

                <!-- disconnected guidance  -->
                <Border VerticalAlignment="Top" Margin="18,12,18,0" Padding="14,11"
                        Background="{DynamicResource WarningSoftBrush}" BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1" CornerRadius="8"
                        Visibility="{Binding Connected, Converter={StaticResource BoolVis},
                                     ConverterParameter=inverse}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" FontSize="12.5" Foreground="{DynamicResource WarningTextBrush}"
                                   TextWrapping="Wrap" VerticalAlignment="Center">
                            <Run Text="现在没有连上任何被控端，页面是空的。" FontWeight="SemiBold"/>
                            <Run Text="默认连本机；要管那台 NAS，在连接页新建一条远程连接（远程 WMI）。"/>
                        </TextBlock>
                        <Button Grid.Column="1" Content="去配置连接" Style="{StaticResource DefaultButton}"
                                Command="{Binding GoToConnectionsCommand}" Padding="10,6" Margin="14,0,0,0"/>
                    </Grid>
                </Border>

                <Border Visibility="{Binding ToastVisible, Converter={StaticResource BoolVis}}">
                    <Border.Style>
                        <Style TargetType="Border" BasedOn="{StaticResource Toast}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ToastIsError}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource DangerDarkBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding ToastText}" Style="{StaticResource ToastText}"/>
                        <Button Content="✕" Style="{StaticResource LinkButton}"
                                Command="{Binding HideToastCommand}"
                                Foreground="{DynamicResource BorderStrongBrush}" Margin="14,0,0,0" FontSize="13"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- status bar  -->
            <Border Grid.Row="2" Style="{StaticResource StatusBar}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <Ellipse Width="8" Height="8" Margin="0,0,7,0" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="{DynamicResource DangerBrush}"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Connected}" Value="True">
                                            <Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Style="{StaticResource StatusBarText}">
                            <Run Text="最后更新 "/>
                            <Run Text="{Binding LastUpdateText, FallbackValue='—', Mode=OneWay}"/>
                        </TextBlock>
                        <TextBlock Style="{StaticResource StatusBarText}" Margin="16,0,0,0"
                                   Text="{Binding ControlledLabel, Mode=OneWay}"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource LinkButton}" Command="{Binding ContactAuthorCommand}"
                                ToolTip="点击用默认邮件客户端发送邮件" Margin="0,0,10,0">
                            <TextBlock Text="{Binding ContactEmail, Mode=OneWay}" FontSize="11"/>
                        </Button>
                        <Button Style="{StaticResource LinkButton}" Command="{Binding CheckUpdateCommand}"
                                ToolTip="点击重新检查更新" Margin="0,0,10,0"
                                Visibility="{Binding UpdateHintText, Converter={StaticResource StrVis}}">
                            <TextBlock Text="{Binding UpdateHintText, Mode=OneWay}" FontSize="11"/>
                        </Button>
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource SuccessSoftBrush}" Margin="0,0,8,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis}}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="管理员" Foreground="{DynamicResource SuccessTextBrush}"/>
                        </Border>
                        <Border Style="{StaticResource Badge}" Background="{DynamicResource DangerSoftBrush}" Margin="0,0,8,0"
                                Visibility="{Binding IsAdmin, Converter={StaticResource BoolVis},
                                             ConverterParameter=inverse}">
                            <TextBlock Style="{StaticResource BadgeText}" Text="普通权限" Foreground="{DynamicResource DangerTextBrush}"/>
                        </Border>
                        <TextBlock Style="{StaticResource StatusBarText}"
                                   Text="{Binding VersionText, Mode=OneWay}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
