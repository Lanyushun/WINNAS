<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 靛紫：冷紫调，层次分明，适合多窗口并排看。
         只放颜色。控件样式在 Styles.xaml，靠 DynamicResource 取这里的键，
         所以换肤只需替换这一个字典。 -->

    <SolidColorBrush x:Key="PageBgBrush" Color="#F5F2FA"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FBF9FE"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
