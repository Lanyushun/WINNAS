    <SolidColorBrush x:Key="SelectedBgBrush" Color="#E6DCF7"/>
    <SolidColorBrush x:Key="HoverBgBrush" Color="#F0EAF9"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DCD2EC"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#BFB0DA"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="#241B3A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4A3D66"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7A6C96"/>
