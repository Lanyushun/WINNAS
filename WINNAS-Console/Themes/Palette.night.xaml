<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 深空黑：夜间值守用，整体压暗，状态色提亮保证可读。
         只放颜色。控件样式在 Styles.xaml，靠 DynamicResource 取这里的键，
         所以换肤只需替换这一个字典。 -->

    <SolidColorBrush x:Key="PageBgBrush" Color="#12161F"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#0D1117"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#1A202B"/>
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#232B38"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#0F141C"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#232B38"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#161C25"/>
    <SolidColorBrush x:Key="SubtleBgBrush" Color="#1F2632"/>
    <SolidColorBrush x:Key="SelectedBgBrush" Color="#1E3A5F"/>
    <SolidColorBrush x:Key="HoverBgBrush" Color="#263041"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#2A3444"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#3A4759"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="#E6EDF7"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B9C4D4"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#8494A8"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="PrimaryDarkBrush" Color="#2F6FE0"/>
