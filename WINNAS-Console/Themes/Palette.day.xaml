    <SolidColorBrush x:Key="SelectedBgBrush" Color="#E8F0FE"/>
    <SolidColorBrush x:Key="HoverBgBrush" Color="#EEF2F7"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBD5E1"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="#0F172A"/>
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#334155"/>
    <SolidColorBrush x:Key="TextMutedBrush" Color="#64748B"/>
    <SolidColorBrush x:Key="TextOnPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PrimaryBrush" Color="#2563EB"/>
