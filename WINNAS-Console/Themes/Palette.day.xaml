<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 极简白：干净的中性浅色，长时间看字最不容易累。
         只放颜色。控件样式在 Styles.xaml，靠 DynamicResource 取这里的键，
         所以换肤只需替换这一个字典。 -->

    <SolidColorBrush x:Key="PageBgBrush" Color="#F4F6F9"/>
    <SolidColorBrush x:Key="SidebarBgBrush" Color="#FDFEFF"/>
    <SolidColorBrush x:Key="CardBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ButtonBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBgBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="HeaderBgBrush" Color="#F1F5F9"/>
    <SolidColorBrush x:Key="RowAltBrush" Color="#F8FAFC"/>
