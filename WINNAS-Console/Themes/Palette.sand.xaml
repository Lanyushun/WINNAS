    <SolidColorBrush x:Key="HoverBgBrush" Color="#F6EFE4"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E2D6C3"/>
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#CBB99E"/>
    <SolidColorBrush x:Key="TextMainBrush" Color="#2E2418"/>
